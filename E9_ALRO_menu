<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu</title>
    <link rel="stylesheet" href="Estilo.css">
</head>
<body>
    <nav class="menu">
        <a href="#">Inicio</a>
        <a href="#">Nosotros</a>
        <a href="#">Productos</a>
        <a href="#">Servicios</a>
        <a href="#">Contacto</a>
    </nav>
</body>
</html>
body {
    margin: 0;
    padding:0 ;
    background-color: #222;
    font-family: Arial,  sans-serif;
}

.menu {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 50px;
}

.menu a {
    color:aliceblue;
    text-decoration: none;
    margin: 15px 0;
    padding: 10px  20px;
    transition: 0.3s;
    border-radius: 5px;
}

.menu a:hover {
    background-color: darkred;
    transform: scale(1.1);
}
